# Fill each placeholder in the deployment environment. Do not commit secrets.
APP_ENV=<local|staging|production> # required; only local uses developer defaults
ALLOWED_ORIGINS=<comma-separated-exact-http-or-https-origins>
DATABASE_URL=<database-connection-string>
QP_URL=<https-quartzplay-base-url>
QP_ALLOWED_HOSTS=<comma-separated-approved-hostnames>
IAQP_SERVICE_KEY=<service-key>
